# Скопируй в secrets.env и заполни только те строки, чьи сервисы используешь.
# Файл secrets.env в git не попадает (см. .gitignore). chmod 600.

# Apify — https://console.apify.com/settings/integrations (Personal API token)
APIFY_TOKEN=

# SpicyAPI — https://spicyapi.ai/console/keys (ключ вида sk-spicy-...)
SPICY_API_KEY=

# OpenRouter — необязательно: если пусто, берётся из ~/.hermes/.env
OPENROUTER_API_KEY=

# OpenCode Zen — необязательно: если пусто, берётся из ~/.local/share/opencode/auth.json
OPENCODE_API_KEY=
